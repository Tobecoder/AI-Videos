  "segments": [
    {
      "id": "s01_01",
      "sceneId": "hook",
      "stepIndex": 0,
      "stepLabel": "实战复盘",
      "displayText": "一条65秒的视频，观众平均看了64秒，跑了5.9万播放、503条评论——你猜视频号分成给了多少钱？",
      "cue": "counter_race",
      "startSec": 0.3,
      "endSec": 8.862,
      "startFrame": 9,
      "endFrame": 266
    },
    {
      "id": "s01_02",
      "sceneId": "hook",
      "stepIndex": 0,
      "stepLabel": "实战复盘",
      "displayText": "答案是：3块9毛3。",
      "cue": "stamp_393",
      "startSec": 9.082,
      "endSec": 11.082,
      "startFrame": 272,
      "endFrame": 332
    },
    {
      "id": "s01_03",
      "sceneId": "hook",
      "stepIndex": 0,
      "stepLabel": "实战复盘",
      "displayText": "我做视频号刚满半个月，涨了240粉，一共发了23条原创，累计播放15.8万多，总收益5块04。",
      "cue": "summary_grid",
      "startSec": 11.302,
      "endSec": 19.668,
      "startFrame": 339,
      "endFrame": 590
    },
    {
      "id": "s01_04",
      "sceneId": "hook",
      "stepIndex": 0,
      "stepLabel": "实战复盘",
      "displayText": "而我每做一条，都要花1到2个小时、外加5块钱左右的制作成本。",
      "cue": "cost_badge",
      "startSec": 19.888,
      "endSec": 24.617,
      "startFrame": 597,
      "endFrame": 739
    },
    {
      "id": "s01_05",
      "sceneId": "hook",
      "stepIndex": 0,
      "stepLabel": "实战复盘",
      "displayText": "今天不画大饼，直接把后台全盘数据摊开，聊聊普通人用AI做视频号到底值不值得干。",
      "cue": "hook_outro",
      "startSec": 24.837,
      "endSec": 31.888,
      "startFrame": 745,
      "endFrame": 957
    },
    {
      "id": "s02_01",
      "sceneId": "niche",
      "stepIndex": 1,
      "stepLabel": "选赛道",
      "displayText": "先说说我做的赛道：AI图文故事集，用AI写文案，再生成这种固定手绘风的图文卡片。",
      "cue": "show_cards",
      "startSec": 32.338,
      "endSec": 39.652,
      "startFrame": 970,
      "endFrame": 1190
    },
    {
      "id": "s02_02",
      "sceneId": "niche",
      "stepIndex": 1,
      "stepLabel": "选赛道",
      "displayText": "其实我真正想做的，是你现在看到的这种知识分享动画。",
      "cue": "ideal_niche",
      "startSec": 39.872,
      "endSec": 43.696,
      "startFrame": 1196,
      "endFrame": 1311
    },
    {
      "id": "s02_03",
      "sceneId": "niche",
      "stepIndex": 1,
      "stepLabel": "选赛道",
      "displayText": "但说实话，我不会视频剪辑，哪怕全靠AI帮忙，做动画的时间和金钱门槛还是太高了。",
      "cue": "cost_barrier",
      "startSec": 43.916,
      "endSec": 51.615,
      "startFrame": 1317,
      "endFrame": 1548
    },
    {
      "id": "s02_04",
      "sceneId": "niche",
      "stepIndex": 1,
      "stepLabel": "选赛道",
      "displayText": "那为什么选图文故事？一方面我刷到这种走心故事自己也会看哭，说明它天生有情绪共鸣；",
      "cue": "emotion_resonance",
      "startSec": 51.835,
      "endSec": 59.725,
      "startFrame": 1555,
      "endFrame": 1792
    },
    {
      "id": "s02_05",
      "sceneId": "niche",
      "stepIndex": 1,
      "stepLabel": "选赛道",
      "displayText": "另一方面，拆解了很多爆款之后我发现：表达形式可以五花八门，但内容本身永远是最核心的。",
      "cue": "core_rule",
      "startSec": 59.945,
      "endSec": 67.53,
      "startFrame": 1798,
      "endFrame": 2026
    },
    {
      "id": "s02_06",
      "sceneId": "niche",
      "stepIndex": 1,
      "stepLabel": "选赛道",
      "displayText": "所以现阶段我先舍弃了喜欢的高门槛形式，挑了一个能低成本、快速跑通的图文赛道先落地。",
      "cue": "mvp_choice",
      "startSec": 67.75,
      "endSec": 74.983,
      "startFrame": 2033,
      "endFrame": 2249
    },
    {
      "id": "s03_01",
      "sceneId": "traffic",
      "stepIndex": 2,
      "stepLabel": "推流机制",
      "displayText": "我的主战场放在视频号，同时也会同步分发到其他平台。",
      "cue": "platforms",
      "startSec": 75.433,
      "endSec": 79.823,
      "startFrame": 2263,
      "endFrame": 2395
    },
    {
      "id": "s03_02",
      "sceneId": "traffic",
      "stepIndex": 2,
      "stepLabel": "推流机制",
      "displayText": "很多人看视频号只要100粉就能开分成计划，觉得门槛特别低，其实这里有个大误区。",
      "cue": "threshold_myth",
      "startSec": 80.043,
      "endSec": 86.431,
      "startFrame": 2401,
      "endFrame": 2593
    },
    {
      "id": "s03_03",
      "sceneId": "traffic",
      "stepIndex": 2,
      "stepLabel": "推流机制",
      "displayText": "因为视频号的分成广告是挂在评论区的——得有人愿意点开评论、看到甚至点击广告，你才有收入。",
      "cue": "comment_ad",
      "startSec": 86.651,
      "endSec": 94.145,
      "startFrame": 2600,
      "endFrame": 2824
    },
    {
      "id": "s03_04",
      "sceneId": "traffic",
      "stepIndex": 2,
      "stepLabel": "推流机制",
      "displayText": "再看推流机制，我发了23条，基本每条都能上1000播放；只要过了500基础门槛，官方就会阶梯式往外推。",
      "cue": "funnel_500",
      "startSec": 94.365,
      "endSec": 103.044,
      "startFrame": 2831,
      "endFrame": 3091
    },
    {
      "id": "s03_05",
      "sceneId": "traffic",
      "stepIndex": 2,
      "stepLabel": "推流机制",
      "displayText": "但能不能推爆，关键看完播、点赞、分享、红心，以及现阶段最重要的评论互动。",
      "cue": "key_signals",
      "startSec": 103.264,
      "endSec": 109.996,
      "startFrame": 3098,
      "endFrame": 3300
    },
    {
      "id": "s04_01",
      "sceneId": "data",
      "stepIndex": 3,
      "stepLabel": "数据复盘",
      "displayText": "光说没用，直接把半个月跑出来的三条65秒小爆款后台数据放一起对比。",
      "cue": "three_cards_in",
      "startSec": 110.446,
      "endSec": 116.348,
      "startFrame": 3313,
      "endFrame": 3490
    },
    {
      "id": "s04_02",
      "sceneId": "data",
      "stepIndex": 3,
      "stepLabel": "数据复盘",
      "displayText": "第一条《跟父亲跑长途的那七天》：3万播放，完播25.59%，平均看了49.53秒，评论46条，涨粉48个。",
      "cue": "card_1_focus",
      "startSec": 116.568,
      "endSec": 126.822,
      "startFrame": 3497,
      "endFrame": 3805
    },
    {
      "id": "s04_03",
      "sceneId": "data",
      "stepIndex": 3,
      "stepLabel": "数据复盘",
      "displayText": "第二条《师恩照亮我一生》：3.2万播放，完播拉到34.26%，平均看59.43秒，点赞895、心心453翻倍，评论169条。",
      "cue": "card_2_focus",
      "startSec": 127.042,
      "endSec": 139.334,
      "startFrame": 3811,
      "endFrame": 4180
    },
    {
      "id": "s04_04",
      "sceneId": "data",
      "stepIndex": 3,
      "stepLabel": "数据复盘",
      "displayText": "第三条《等不来的道歉》：5.9万播放，完播冲到38.11%，平均看了64.07秒，评论直接炸到503条，涨粉75个！",
      "cue": "card_3_focus",
      "startSec": 139.554,
      "endSec": 150.471,
      "startFrame": 4187,
      "endFrame": 4514
    },
    {
      "id": "s04_05",
      "sceneId": "data",
      "stepIndex": 3,
      "stepLabel": "数据复盘",
      "displayText": "你看一个很有意思的现象：《师恩》的点赞和红心其实比《道歉》高得多，但《道歉》的播放却几乎翻了一倍。",
      "cue": "insight_compare",
      "startSec": 150.691,
      "endSec": 157.452,
      "startFrame": 4521,
      "endFrame": 4724
    },
    {
      "id": "s04_06",
      "sceneId": "data",
      "stepIndex": 3,
      "stepLabel": "数据复盘",
      "displayText": "核心差距就在两点：完播率咬得更死，而且它戳中了很多人童年的委屈，把评论区彻底引爆了。",
      "cue": "insight_highlight",
      "startSec": 157.672,
      "endSec": 164.891,
      "startFrame": 4730,
      "endFrame": 4947
    },
    {
      "id": "s04_07",
      "sceneId": "data",
      "stepIndex": 3,
      "stepLabel": "数据复盘",
      "displayText": "所以底层逻辑很清晰：情感赛道必须调动情绪，而技能知识号必须给出实打实的价值——让人省时间或少踩坑。",
      "cue": "dual_formula",
      "startSec": 165.111,
      "endSec": 174.353,
      "startFrame": 4953,
      "endFrame": 5231
    },
    {
      "id": "s05_01",
      "sceneId": "playbook",
      "stepIndex": 4,
      "stepLabel": "起号实操",
      "displayText": "结合这半个月实战，给刚起步的新手两条最实在的建议。",
      "cue": "playbook_intro",
      "startSec": 174.803,
      "endSec": 179.39,
      "startFrame": 5244,
      "endFrame": 5382
    },
    {
      "id": "s05_02",
      "sceneId": "playbook",
      "stepIndex": 4,
      "stepLabel": "起号实操",
      "displayText": "第一，宁可少而精，别拿低质水货凑数。",
      "cue": "quality_first",
      "startSec": 179.61,
      "endSec": 182.984,
      "startFrame": 5388,
      "endFrame": 5490
    },
    {
      "id": "s05_03",
      "sceneId": "playbook",
      "stepIndex": 4,
      "stepLabel": "起号实操",
      "displayText": "我一开始也天天盯着100粉焦急，后来才看明白：好作品的吸粉是指数级的，有人一条就能涨上千粉。",
      "cue": "growth_curve",
      "startSec": 183.204,
      "endSec": 190.387,
      "startFrame": 5496,
      "endFrame": 5712
    },
    {
      "id": "s05_04",
      "sceneId": "playbook",
      "stepIndex": 4,
      "stepLabel": "起号实操",
      "displayText": "只要保持内容垂直和规律更新，把精力花在打磨单篇质量上，比硬水数量划算得多。",
      "cue": "vertical_consistency",
      "startSec": 190.607,
      "endSec": 196.849,
      "startFrame": 5718,
      "endFrame": 5905
    },
    {
      "id": "s05_05",
      "sceneId": "playbook",
      "stepIndex": 4,
      "stepLabel": "起号实操",
      "displayText": "第二，憋不出选题别硬憋，先学会站在同赛道爆款肩膀上改写。",
      "cue": "remix_intro",
      "startSec": 197.069,
      "endSec": 202.331,
      "startFrame": 5912,
      "endFrame": 6070
    },
    {
      "id": "s05_06",
      "sceneId": "playbook",
      "stepIndex": 4,
      "stepLabel": "起号实操",
      "displayText": "成熟的爆款情绪核已经被市场验证过了，你可以保留核心冲突，只换视角和细节——比如把小姨的故事改成姐姐或妹妹视角，下限绝不会差。",
      "cue": "perspective_swap",
      "startSec": 202.551,
      "endSec": 213.67,
      "startFrame": 6077,
      "endFrame": 6410
    },
    {
      "id": "s06_01",
      "sceneId": "roi",
      "stepIndex": 5,
      "stepLabel": "算账反思",
      "displayText": "最后回到大家最关心的算账环节。",
      "cue": "roi_intro",
      "startSec": 214.12,
      "endSec": 216.428,
      "startFrame": 6424,
      "endFrame": 6493
    },
    {
      "id": "s06_02",
      "sceneId": "roi",
      "stepIndex": 5,
      "stepLabel": "算账反思",
      "displayText": "前面《长途》和《师恩》发得早，还没开分成；但《等不来的道歉》是全程完整参与了分成计划的。",
      "cue": "plan_timeline",
      "startSec": 216.648,
      "endSec": 223.16,
      "startFrame": 6499,
      "endFrame": 6695
    },
    {
      "id": "s06_03",
      "sceneId": "roi",
      "stepIndex": 5,
      "stepLabel": "算账反思",
      "displayText": "5.9万播放、503条评论、38%的完播，最后结算只有3块9毛3；半个月累计158,921播放，总收益才5块04。",
      "cue": "roi_numbers",
      "startSec": 223.38,
      "endSec": 233.559,
      "startFrame": 6701,
      "endFrame": 7007
    },
    {
      "id": "s06_04",
      "sceneId": "roi",
      "stepIndex": 5,
      "stepLabel": "算账反思",
      "displayText": "而我做一篇就要花1到2个小时、外加5块钱成本——跑出一篇近6万播放的爆款，分成还没打平这一篇的5块钱制作费。",
      "cue": "roi_deficit",
      "startSec": 233.779,
      "endSec": 242.084,
      "startFrame": 7013,
      "endFrame": 7263
    },
    {
      "id": "s06_05",
      "sceneId": "roi",
      "stepIndex": 5,
      "stepLabel": "算账反思",
      "displayText": "现在各行各业卷自媒体卷得仿佛账号比人口还多，当然账号做起来以后还有接广、带货等变现路子，不能只看前期分成；",
      "cue": "market_crowded",
      "startSec": 242.304,
      "endSec": 252.118,
      "startFrame": 7269,
      "endFrame": 7564
    },
    {
      "id": "s06_06",
      "sceneId": "roi",
      "stepIndex": 5,
      "stepLabel": "算账反思",
      "displayText": "但入场前真得想清楚：这个赛道的投入产出比，你能不能长期熬下去？",
      "cue": "roi_question",
      "startSec": 252.338,
      "endSec": 257.67,
      "startFrame": 7570,
      "endFrame": 7730
    },
    {
      "id": "s06_07",
      "sceneId": "roi",
      "stepIndex": 5,
      "stepLabel": "算账反思",
      "displayText": "对我来说，这半个月算交了一笔极低成本的学费；接下来我也准备把经验沉淀下来，切回我真正想做的知识分享赛道——就像你现在看到的这条视频一样。",
      "cue": "pivot_meta",
      "startSec": 257.89,
      "endSec": 268.953,
      "startFrame": 7737,
      "endFrame": 8069
    },
    {
      "id": "s06_08",
      "sceneId": "roi",
      "stepIndex": 5,
      "stepLabel": "算账反思",
      "displayText": "如果你也在做视频号，你单条最高播放分了多少钱？或者你觉得我下一步该继续死磕故事号，还是转型知识动画？评论区聊聊你的真实战绩。",
      "cue": "closing_cta",
      "startSec": 269.173,
      "endSec": 280.348,
      "startFrame": 8075,
      "endFrame": 8410
    }
  ],
